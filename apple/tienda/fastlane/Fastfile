# Ficha de App Store de las tres apps (textos, categoría, capturas, datos del revisor).
# Lo lanza el flujo «Ficha App Store». No sube binarios. Solo envía a revisión si ENVIAR=true.
default_platform(:ios)

lane :ficha do
  app = ENV.fetch("APP")
  base = File.expand_path("../#{app}", __dir__)
  enviar = ENV["ENVIAR"] == "true"
  app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_content: ENV.fetch("ASC_KEY_P8"), in_house: false)
  opts = {
    app_identifier: ENV.fetch("BUNDLE_ID"), app_version: "1.0", platform: "ios",
    metadata_path: "#{base}/metadata", screenshots_path: "#{base}/screenshots",
    skip_binary_upload: true, force: true, overwrite_screenshots: true,
    skip_screenshots: ENV["SIN_CAPTURAS"] == "true",
    run_precheck_before_submit: false, precheck_include_in_app_purchases: false,
    submit_for_review: enviar, automatic_release: true,
    submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false, content_rights_contains_third_party_content: false }
  }
  carta = "#{base}/carta_autorizacion.pdf"
  opts[:app_review_attachment_file] = carta if File.exist?(carta)
  deliver(opts)
end
