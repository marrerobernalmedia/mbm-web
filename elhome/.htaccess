# La app siempre pide al servidor la versión vigente de estos archivos (los cambios se ven al momento);
# las imágenes y miniaturas sí se guardan.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

# Sitio www.elhomedelarisa.com (mismo código que la app). Las reglas de WordPress del directorio padre no aplican aquí.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^elhomedelarisa\.com$ [NC]
  RewriteRule ^(.*)$ https://www.elhomedelarisa.com/$1 [R=301,L]
</IfModule>
ErrorDocument 404 /404.html
